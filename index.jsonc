{
  "name": "aud_audio_vst3",
  "summary": "VST3 shell of the Audanika Audio Engine over its headless host.",
  "domain": [
    "VST3 shell over the headless host (S18): presets, parameters, DAW MIDI and transport, state, symbol hygiene",
    "Flutter editor out of process: shell protocol over an inherited socket, shared IOSurfaces, forwarded input, MIDI to the DAW (plugin-003, plugin-007)",
    "Vendored VST3 SDK 3.8.1 subset; Node build, validator, test host, REAPER and probe scripts"
  ],
  "interfaces": {
    "uses": {
      "aud_audio_graph": "package dependency; the headless host in C",
      "aud_audio_core": "package dependency; AudCommand, the SPSC ring"
    },
    "usedBy": {}
  }
}
